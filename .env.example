# ==============================================================================
# Household Finance Platform - Variables de entorno de ejemplo
# Copiar a .env y ajustar los valores antes de ejecutar docker compose
# ==============================================================================

# --- PostgreSQL (instancia unica, un esquema/usuario por servicio) ---
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=changeme-postgres
POSTGRES_PORT=5432

IDENTITY_DB_NAME=identity_db
IDENTITY_DB_USER=identity_user
IDENTITY_DB_PASSWORD=changeme-identity

FINANCE_DB_NAME=finance_db
FINANCE_DB_USER=finance_user
FINANCE_DB_PASSWORD=changeme-finance

# --- JWT ---
JWT_SECRET=this-is-a-development-only-secret-key-please-change-me-32bytes-min
JWT_ISSUER=household-finance-platform
JWT_AUDIENCE=household-finance-clients
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30

# --- Puertos expuestos ---
IDENTITY_SERVICE_PORT=8081
FINANCE_SERVICE_PORT=8082
WEB_BFF_PORT=8080
MOBILE_BFF_PORT=8090
PGADMIN_PORT=5050

# --- pgAdmin (perfil opcional "admin-tools") ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=changeme-pgadmin

# --- Observabilidad (perfil opcional "observability") ---
GRAFANA_ADMIN_PASSWORD=changeme-grafana

# --- CORS ---
WEB_BFF_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000

# --- Nivel de logging ---
LOG_LEVEL=INFO
